# Shared key, optional when every user adds their own key in Settings
OPENROUTER_API_KEY=sk-or-v1-...
# Encrypts users' personal keys. 64 hex chars. If unset, one is generated into data/secret.key
APP_SECRET=
PORT=3210
# Max models answering per turn (PRD: 3 for free users)
MAX_MODELS=3

# Langfuse tracing (optional). Leave the keys empty to turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com   or your self-hosted URL
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to false to send only metadata (models, tokens, cost, timing), not prompts or answers.
LANGFUSE_LOG_CONTENT=true
LANGFUSE_ENVIRONMENT=development

# Jev evaluator by TypeSafe (optional). Users can also add their own key in Settings.
# Without any key, evaluations use a free fallback judge on OpenRouter.
TYPESAFE_API_KEY=
# TYPESAFE_API_BASE=https://api.typesafe.ai
